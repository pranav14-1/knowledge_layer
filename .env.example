# Gemini API Key for Grounded Chat Assistant
GEMINI_API_KEY="your_gemini_api_key_here"

# Extraction & Parsing Mode: 'fast' (100% offline, 0 API quota), 'smart', or 'full'
EXTRACTION_MODE=fast

# Database Connection (SQLite default, or PostgreSQL e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./facts.db

# Storage directory for uploaded PDF files (relative or absolute path)
UPLOAD_DIR=./backend/uploads

# Port for backend server
PORT=8000

